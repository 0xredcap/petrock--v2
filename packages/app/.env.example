# Hedera testnet operator
HEDERA_OPERATOR_ID=0.0.XXXXXXX
HEDERA_OPERATOR_KEY=302e0201...
HEDERA_NETWORK=testnet

# Pre-created NFT collection (created via `npm run setup:collection`)
PET_ROCK_NFT_COLLECTION_ID=

# Global pet registry HCS topic (created via `npm run setup:registry`)
PET_ROCK_REGISTRY_TOPIC_ID=

# LLM
GOOGLE_API_KEY=AIza...

# Machine Payments Protocol (MPP) — server side
# Generate with: npx mppx account create (autofunds on testnet)
MPP_RECIPIENT_ADDRESS=0x...
MPP_CURRENCY=0x20c0000000000000000000000000000000000000

# MPP — agent buyer key (generate with: npx mppx account create)
MPP_AGENT_PRIVATE_KEY=0x...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time admin secret for the /api/setup/collection HTTP endpoint
# (only needed if triggering collection creation via HTTP, not via npm run setup:collection)
SETUP_SECRET=

# HashPack WalletConnect (get project ID from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# CoinCap API (get at pro.coincap.io or leave blank for anonymous)
COINCAP_BEARER_TOKEN=
