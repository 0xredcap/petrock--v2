{
  "name": "petrock-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@petrock/app",
    "build": "npm run build --workspace=@petrock/app",
    "lint": "npm run lint --workspace=@petrock/app",
    "setup:registry": "npx tsx packages/app/scripts/setup-registry.ts"
  }
}
